pipeline {
    agent any

    tools {
        jdk 'jdk17' // This must match the name in Jenkins global tool config
    }

    environment {
        JAVA_HOME = "${tool 'jdk17'}"
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('SonarQube Analysis') {
            steps {
                sh 'java -version' // confirm it's Java 17
                sh 'mvn clean verify sonar:sonar'
            }
        }
    }
}
